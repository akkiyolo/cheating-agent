# Copy to .env and adjust. .env is git-ignored.

# Required by docker-compose and whenever ENV=prod: a random string of at least 32 characters (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET=

# Local (non-Docker) backend: Postgres from `docker compose up db`, or SQLite for quick hacking
DATABASE_URL=postgresql+asyncpg://assess:assess@localhost:5433/assessment
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Seed account passwords — change before exposing the server beyond localhost
ADMIN_PASSWORD=admin-pass
RESEARCHER_PASSWORD=researcher-pass
CANDIDATE_PASSWORD=candidate-pass

# Optional
# POSTGRES_PASSWORD=assess
# ASSESSMENT_DURATION_S=3600
# SANDBOX_TIMEOUT_S=10
